---
import type { Project } from "../data/projects";
import { Image } from 'astro:assets';


interface Props extends Project {
  index: number;
}

const { name, domain, description, icon, index } = Astro.props;
---

<a
  href={`https://${domain}`}
  target="_blank"
  rel="noopener noreferrer"
  class="project-row group grid grid-cols-[auto_1fr] items-start gap-x-4 gap-y-2 py-6 no-underline sm:grid-cols-[auto_1fr_auto] sm:items-center sm:gap-x-6 sm:py-7 md:gap-x-8"
  style={`--d:${0.18 + index * 0.07}s`}
>
  <span
    class="flex size-14 shrink-0 items-center justify-center overflow-hidden rounded-none transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:-translate-y-0.5 group-active:scale-[0.97] md:size-16 md:rounded-none"
  >
    <Image
      src={icon}
      alt=""
      width={64}
      height={64}
      densities={[2]}
      layout="fixed"
      class="size-full object-cover"
    />
  </span>

  <span class="min-w-0 pt-0.5 sm:pt-0">
    <span
      class="block font-sans text-[1.15rem] font-semibold leading-tight tracking-[-0.03em] text-fg transition-colors duration-200 group-hover:text-vermilion md:text-[1.3rem]"
    >
      {name}
    </span>
    <span
      class="mt-1 block max-w-[42ch] text-[0.925rem] leading-relaxed text-fg/55 transition-colors duration-200 group-hover:text-fg/75"
    >
      {description}
    </span>
  </span>

  <span
    class="col-start-2 flex items-center gap-1.5 font-mono text-[11px] tracking-[0.04em] text-fg/35 transition-colors duration-200 group-hover:text-vermilion sm:col-start-auto sm:justify-self-end"
  >
    {domain}
    <svg
      class="size-3.5 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
      viewBox="0 0 16 16"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M4.5 11.5 11.5 4.5M6 4.5h5.5V10"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </span>
</a>
