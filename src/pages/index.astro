---
import Layout from "../layouts/Layout.astro";
import Mark from "../components/Mark.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { projects } from "../data/projects";
---

<Layout>
  <div class="relative min-h-dvh">
    <header
      class="relative flex min-h-[38vh] flex-col justify-end overflow-hidden bg-hero px-6 pb-16 pt-16 text-cream sm:min-h-[42vh] sm:px-10 sm:pb-20 sm:pt-20 md:px-16 md:pb-24"
    >
      <div
        class="pointer-events-none absolute -right-24 -top-28 size-[28rem] rounded-full bg-cream/8 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div class="relative mx-auto w-full max-w-5xl">
        <Mark
          class="hero-in mb-8 h-auto w-[4.75rem] text-cream sm:mb-10 sm:w-24 md:w-[6.75rem]"
        />

        <h1
          class="hero-in max-w-[12ch] font-sans text-[clamp(2.6rem,8.5vw,6.25rem)] font-semibold leading-[0.92] tracking-[-0.045em] text-cream"
        >
          SpacemanCodes
        </h1>

        <p
          class="hero-in-late mt-6 max-w-[28ch] text-[15px] leading-relaxed tracking-[-0.01em] text-cream/80 md:mt-8 md:text-base"
        >
          We build things.
        </p>
      </div>
    </header>

    <main class="relative bg-page text-fg">
      <section
        class="mx-auto w-full max-w-5xl px-6 py-12 sm:px-10 sm:py-16 md:px-16 md:py-20"
        aria-labelledby="projects-heading"
      >
        <div class="mb-4 flex items-baseline justify-between gap-4 sm:mb-6">
          <h2
            id="projects-heading"
            class="font-mono text-[11px] font-medium uppercase tracking-[0.22em] text-fg/40"
          >
            Projects
          </h2>
          <span class="font-mono text-[11px] tracking-[0.08em] text-fg/25">
            {String(projects.length).padStart(2, "0")}
          </span>
        </div>

        <ul class="divide-y divide-fg/10 border-t border-fg/10">
          {
            projects.map((project, i) => (
              <li>
                <ProjectRow {...project} index={i} />
              </li>
            ))
          }
        </ul>
      </section>
    </main>

    <footer
      class="border-t border-fg/10 bg-page px-6 py-8 sm:px-10 md:px-16"
    >
      <div
        class="mx-auto flex w-full max-w-5xl flex-col gap-2 sm:flex-row sm:items-center sm:justify-between"
      >
        <p class="font-mono text-[11px] tracking-[0.06em] text-fg/40">
          SpacemanCodes LTD
        </p>
        <a
          href="mailto:mason@spacemancodes.com"
          class="font-mono text-[11px] tracking-[0.06em] text-fg/30 no-underline transition-colors duration-200 hover:text-vermilion"
        >
          mason@spacemancodes.com
        </a>
      </div>
    </footer>
  </div>
</Layout>
